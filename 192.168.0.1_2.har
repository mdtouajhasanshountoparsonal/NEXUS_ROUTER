            "mimeType": "text/html",
            "compression": 0,
            "text": "<script language=\"javascript\" type=\"text/javascript\">var showNum=10;function getTbl(staList){removeAll();var tbl=$.id(\"staTbl\");var tIndex=1;$.each(staList,function(arg,index){if(INCLUDE_LAN_WLAN_MSSID){row=tbl.insertRow(-1);cell=row.insertCell(-1);cell.innerHTML=tIndex;cell.width=\"4%\";tIndex++;cell=row.insertCell(-1);cell.innerHTML=this.associatedDeviceMACAddress;cell.width=\"20%\";cell=row.insertCell(-1);cell.innerHTML=\"<span class='T T_associated'>\"+s_str.associated+\"</span>\";cell.width=\"15%\";cell=row.insertCell(-1);cell.innerHTML=$.formatNum(this.X_TP_TotalPacketsReceived);cell.width=\"13%\";cell=row.insertCell(-1);cell.innerHTML=$.formatNum(this.X_TP_TotalPacketsSent);cell.width=\"10%\";cell=row.insertCell(-1);var vapName=this.X_TP_HostName;var vapSSID;var htmlSSID;if(vapName==wlanObj.name&&$.sysMode!=\"MSSID\"){vapSSID=wlanObj.SSID}else{$.each(vapList,function(){if(vapName==this.name){vapSSID=this.SSID}})}htmlSSID=vapSSID;cell.innerHTML=htmlSSID}else{row=tbl.insertRow(-1);cell=row.insertCell(-1);cell.innerHTML=index+1;cell.width=\"5%\";cell=row.insertCell(-1);cell.innerHTML=this.associatedDeviceMACAddress;cell.width=\"20%\";cell=row.insertCell(-1);cell.innerHTML=\"<span class='T T_associated'>\"+s_str.associated+\"</span>\";cell.width=\"25%\";cell=row.insertCell(-1);cell.innerHTML=$.formatNum(this.X_TP_TotalPacketsReceived);cell=row.insertCell(-1);cell.innerHTML=$.formatNum(this.X_TP_TotalPacketsSent);cell.width=\"25%\"}});$.resize(tbl,showNum)}function removeAll(){var tbl=$.id(\"staTbl\");while(tbl.rows.length>1){tbl.deleteRow(-1)}}function refresh(obj){var staList;if(INCLUDE_LAN_WLAN_MSSID){$.removeClass($.id(\"tlbHeadMssid\"),\"nd\")}else{$.removeClass($.id(\"tlbHead\"),\"nd\")}$.addLoading(obj);$.act(ACT_OP,ACT_OP_WLAN_UPDATE_ASSOC,wlanObj.__stack);$.exe(function(ret){if(!ret){staList=$.act(ACT_GS,LAN_WLAN_ASSOC_DEV,null,wlanObj.__stack,[\"AssociatedDeviceMACAddress\",\"X_TP_TotalPacketsSent\",\"X_TP_TotalPacketsReceived\",\"X_TP_HostName\"]);$.exe(function(ret){if(!ret){if(INCLUDE_LAN_WLAN_GUESTNETWORK){var count=0;$.each(staList,function(arg,index){count++});$.h($.id(\"tip\"),count)}else{$.h($.id(\"tip\"),staList.length)}getTbl(staList);$.removeLoading()}})}})};</script>\r\n<p class=\"et T\" id=\"et\">Wireless Statistics</p>\r\n<div class=\"con1 L\">\r\n<p class=\"ct\"></p>\r\n<p class=\"bl\"></p> \r\n<div class=\"con2\">\r\n\r\n<p align=\"left\"><span class=\"T\" id=\"t_tip\">Current Connected Wireless Stations numbers:</span> <i class=\"bd\" id=\"tip\">0</i> <input type=\"button\" class=\"button L T T_refresh\" value=\"Refresh\" id=\"refresh\" onclick=\"refresh(this)\" /></p>\r\n<p class=\"br\"></p>\r\n<div class=\"XXL thead nd\" id=\"tlbHead\"><table class=\"L bdr tc\"><tr><th class=\"T T_id\" width=\"5%\">ID</th><th class=\"T T_macaddr\" width=\"20%\">Mac Address</th><th width=\"25%\" class=\"T\" id=\"t_curstat1\">Current Status</th><th width=\"25%\" class=\"T\" id=\"t_rxpkts1\">Received Packets</th><th class=\"T\" id=\"t_txpkts1\">Sent Packets</th></tr></table>\r\n</div>\r\n<div class=\"XXL thead nd\" id=\"tlbHeadMssid\"><table class=\"L bdr tc\" id=\"staTbl\"><tr><th class=\"T T_id\" width=\"4%\">ID</th><th class=\"T T_macaddr\" width=\"20%\">Mac Address</th><th width=\"15%\" class=\"T\" id=\"t_curstat2\">Current Status</th><th width=\"13%\" class=\"T\" id=\"t_rxpkts2\">Received Packets</th><th width=\"12%\" class=\"T\" id=\"t_txpkts2\">Sent Packets</th><th>SSID</th></tr></table>\r\n</div>\r\n\r\n</div>\r\n<p class=\"bl\"></p> \r\n<p class=\"tail\" id=\"tail\"></p>\r\n</div>\r\n<script language=\"JavaScript\" type=\"text/javascript\">$.loadHelpFrame(\"WlanStationHelpRpm.htm\");var wlanObj,statsList;statsList=$.act(ACT_GL,LAN_WLAN,null,null,[\"name\",\"SSID\"]);if(INCLUDE_WAN_MODE){var sysMode=$.act(ACT_GET,SYS_MODE,null,null,[\"mode\"])}if(!$.exe()){wlanObj=statsList[0]}if(INCLUDE_LAN_WLAN_MSSID){var vapList;vapList=$.act(ACT_GS,LAN_WLAN_MSSIDENTRY,null,wlanObj.__stack,[\"Name\",\"SSID\"]);if(INCLUDE_LAN_WLAN_GUESTNETWORK){var guestObj=$.act(ACT_GET,LAN_WLAN_GUESTNET,wlanObj.__stack,null,[\"Name\"])}if(!$.exe()){}}refresh($.id(\"refresh\"));$.timeout($.reload,5000);</script>\r\n"
