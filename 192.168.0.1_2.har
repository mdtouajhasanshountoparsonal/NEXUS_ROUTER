}}$.exe(function(ret){if(!ret){initShow(0)}$.removeLoading()})}function doSubmit(){if(INCLUDE_LAN_WLAN_MSSID&&$.id(\"apsec\").value>0){doVapSubmit()}else{doWlanSubmit()}}function reboot(){$.loadMain(\"restart.htm\")}function doSave(obj){if(checkValue()){$.addLoading(obj);doSubmit()}}if(INCLUDE_LAN_WLAN_MSSID){function getVapObj(i){var j=1;$.each(vapList,function(arg,index){if(INCLUDE_LAN_WLAN_GUESTNETWORK&&this.name==guestNetObj.name){}else{if(j==i){vapObj=this;j++}else{j++}}})}function initSelect(){var opt=$.c(\"option\");opt.text=wlanObj.SSID;if(!$.flag){opt.innerHTML=wlanObj.SSID.replace(/\\&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/ /g,\"&nbsp;\")}opt.value=0;try{$.id(\"apsec\").add(opt,null)}catch(e){$.id(\"apsec\").add(opt)}if(mssidObj.multiSSIDEnable==1){var i=1,j=0;for(i=1;i<=vapList.length;i++){if(INCLUDE_LAN_WLAN_GUESTNETWORK&&vapList[i-1].name==guestNetObj.name){continue}else{j++}getVapObj(j);if(vapObj.enable==1){var opt=$.c(\"option\");opt.text=vapObj.SSID;if(!$.flag){opt.innerHTML=vapObj.SSID.replace(/\\&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/ /g,\"&nbsp;\")}opt.value=j;try{$.id(\"apsec\").add(opt,null)}catch(e){$.id(\"apsec\").add(opt)}}}}}function doVapSubmit(){getVapObj($.id(\"apsec\").value);if($.id(\"secNone\").checked==true){$.act(ACT_SET,LAN_WLAN_MSSIDENTRY,vapObj.__stack,null,[\"BeaconType=Basic\",\"BasicEncryptionModes=None\",\"BasicAuthenticationMode=None\"])}else{if($.id(\"secWEP\").checked==true){var index=1;var authType;if($.id(\"wepAuthType\").value==\"open\"){authType=\"None\"}else{if($.id(\"wepAuthType\").value==\"shared\"){authType=\"SharedAuthentication\"}else{if($.id(\"wepAuthType\").value==\"auto\"){authType=\"Auto\"}}}$.each(wepList,function(arg,index){var key;if(0==$.id(\"length\"+(index+1)).value){key=\"\"}else{key=$.id(\"key\"+(index+1)).value}$.act(ACT_SET,LAN_WLAN_MSSIDWEPKEY,this.__stack,null,[\"WEPKey=\"+key])});for(index=1;index<=4;index++){if($.id(\"keynum\"+index).checked==true){break}}$.act(ACT_SET,LAN_WLAN_MSSIDENTRY,vapObj.__stack,null,[\"BeaconType=Basic\",\"WEPKeyIndex=\"+index,\"BasicEncryptionModes=WEPEncryption\",\"BasicAuthenticationMode=\"+authType])}else{if($.id(\"secPSK\").checked==true){var groupInterval=parseInt($.id(\"interval\").value,10);var encryType;if($.id(\"pskCipher\").value==0){encryType=\"TKIPandAESEncryption\"}else{if($.id(\"pskCipher\").value==1){encryType=\"TKIPEncryption\"}else{encryType=\"AESEncryption\"}}if($.id(\"pskAuthType\").value==0){$.act(ACT_SET,LAN_WLAN_MSSIDENTRY,vapObj.__stack,null,[\"BeaconType=WPAand11i\",\"WPAAuthenticationMode=PSKAuthentication\",\"WPAEncryptionModes=\"+encryType,\"IEEE11iAuthenticationMode=PSKAuthentication\",\"IEEE11iEncryptionModes=\"+encryType,\"PreSharedKey=\"+$.id(\"pskSecret\").value,\"GroupKeyUpdateInterval=\"+groupInterval])}else{if($.id(\"pskAuthType\").value==1){$.act(ACT_SET,LAN_WLAN_MSSIDENTRY,vapObj.__stack,null,[\"BeaconType=WPA\",\"WPAAuthenticationMode=PSKAuthentication\",\"WPAEncryptionModes=\"+encryType,\"PreSharedKey=\"+$.id(\"pskSecret\").value,\"GroupKeyUpdateInterval=\"+groupInterval])}else{$.act(ACT_SET,LAN_WLAN_MSSIDENTRY,vapObj.__stack,null,[\"BeaconType=11i\",\"IEEE11iAuthenticationMode=PSKAuthentication\",\"IEEE11iEncryptionModes=\"+encryType,\"PreSharedKey=\"+$.id(\"pskSecret\").value,\"GroupKeyUpdateInterval=\"+groupInterval])}}}else{if($.id(\"secWPA\").checked=true){var groupInterval=parseInt($.id(\"wpainterval\").value,10);var encryType;if($.id(\"wpaCipher\").value==0){encryType=\"TKIPandAESEncryption\"}else{if($.id(\"wpaCipher\").value==1){encryType=\"TKIPEncryption\"}else{encryType=\"AESEncryption\"}}if($.id(\"wpaAuthType\").value==0){$.act(ACT_SET,LAN_WLAN_MSSIDENTRY,vapObj.__stack,null,[\"BeaconType=WPAand11i\",\"WPAAuthenticationMode=EAPAuthentication\",\"WPAEncryptionModes=\"+encryType,\"IEEE11iAuthenticationMode=EAPAuthentication\",\"IEEE11iEncryptionModes=\"+encryType,\"GroupKeyUpdateInterval=\"+groupInterval,\"RadiusServerIP=\"+$.id(\"wpaSerIP\").value,\"RadiusServerPort=\"+$.id(\"wpaSerPort\").value,\"RadiusServerPassword=\"+$.id(\"wpaSerPwd\").value])}else{if($.id(\"wpaAuthType\").value==1){$.act(ACT_SET,LAN_WLAN_MSSIDENTRY,vapObj.__stack,null,[\"BeaconType=WPA\",\"WPAAuthenticationMode=EAPAuthentication\",\"WPAEncryptionModes=\"+encryType,\"GroupKeyUpdateInterval=\"+groupInterval,\"RadiusServerIP=\"+$.id(\"wpaSerIP\").value,\"RadiusServerPort=\"+$.id(\"wpaSerPort\").value,\"RadiusServerPassword=\"+$.id(\"wpaSerPwd\").value])}else{$.act(ACT_SET,LAN_WLAN_MSSIDENTRY,vapObj.__stack,null,[\"BeaconType=11i\",\"IEEE11iAuthenticationMode=EAPAuthentication\",\"IEEE11iEncryptionModes=\"+encryType,\"GroupKeyUpdateInterval=\"+groupInterval,\"RadiusServerIP=\"+$.id(\"wpaSerIP\").value,\"RadiusServerPort=\"+$.id(\"wpaSerPort\").value,\"RadiusServerPassword=\"+$.id(\"wpaSerPwd\").value])}}}}}}$.exe(function(ret){if(!ret){vapList=$.act(ACT_GS,LAN_WLAN_MSSIDENTRY,null,wlanObj.__stack,[\"Name\",\"Enable\",\"SSID\",\"SSIDAdvertisementEnable\",\"isolateClients\",\"BeaconType\",\"BasicAuthenticationMode\",\"WEPKeyIndex\",\"BasicEncryptionModes\",\"WPAEncryptionModes\",\"WPAAuthenticationMode\",\"IEEE11iEncryptionModes\",\"IEEE11iAuthenticationMode\",\"PreSharedKey\",\"GroupKeyUpdateInterval\",\"radiusServerIP\",\"radiusServerPort\",\"radiusServerPassword\"]);$.exe(function(ret){if(!ret){initShow($.id(\"apsec\").value)}$.removeLoading()})}else{$.removeLoading()}})}}function getWlanObj(){var wlanList=$.act(ACT_GL,LAN_WLAN,null,null,[\"name\",\"SSID\",\"Enable\",\"X_TP_Configuration_Modified\",\"beaconType\",\"Standard\",\"WEPEncryptionLevel\",\"WEPKeyIndex\",\"BasicEncryptionModes\",\"BasicAuthenticationMode\",\"WPAEncryptionModes\",\"WPAAuthenticationMode\",\"IEEE11iEncryptionModes\",\"IEEE11iAuthenticationMode\",\"X_TP_PreSharedKey\",\"X_TP_GroupKeyUpdateInterval\",\"X_TP_RadiusServerIP\",\"X_TP_RadiusServerPort\",\"X_TP_RadiusServerPassword\"]);$.exe();wlanObj=wlanList[0];if(INCLUDE_LAN_WLAN_MSSID){mssidObj=$.act(ACT_GET,LAN_WLAN_MULTISSID,wlanObj.__stack,null,[\"MultiSSIDEnable\"])}wpsObj=$.act(ACT_GET,LAN_WLAN_WPS,wlanObj.__stack,null,[\"Enable\"]);$.exe()};</script>\r\n<p class=\"et T\" id=\"et\">Wireless Security Settings</p>\r\n<div class=\"con1 L\">\r\n<p class=\"ct\"></p> \r\n<p class=\"bl\"></p> \r\n<div class=\"con2\">\r\n<p class=\"nd\" id=\"11nTip\"><i class=\"T\" id=\"t_note1\">Note: WEP security and TKIP encryption are not supported in 11n only mode.</i></p>\r\n<p class=\"nd\" id=\"qssTip\"><i class=\"T\" id=\"t_note2\">Note: WEP security, WPA/WPA2-Enterprise authentication and TKIP encryption are not supported with WPS enabled.</i></p>\r\n<p class=\"nd\" id=\"mssidTip\"><i class=\"T\" id=\"t_note3\">Note: WEP encryption are not supported with Guest Network enabled.</i></p>\r\n<p><i id=\"t_note4\" class=\"T\">For network security, it is strongly recommended to enable wireless security and use WPA-PSK AES encryption.</i></p>\r\n<p class=\"br\"></p>\r\n<div class=\"nd\" id=\"MssidSel\">\r\n<p>\r\n  <b class=\"item L\">SSID:</b><select id=\"apsec\" name=\"apsec\" style=\"width:200px\"  onchange=\"initShow(1);\"></select>\r\n</p>\r\n<p class=\"br\"></p>\r\n</div>\r\n<p><input name=\"secType\" type=\"radio\" value=\"0\" id=\"secNone\" /> <b class=\"T T_wldissec\">Disable Wireless Security</b></p>\r\n<p class=\"br\"></p>\r\n<p><input name=\"secType\" type=\"radio\" value=\"3\" id=\"secPSK\" /> <b><span id=\"t_wpaPersonal\">WPA/WPA2 - Personal</span><span class=\"T T_recom\">(Recommended)</span></b></p>\r\n<p><b class=\"item L T T_version\">Version:</b> <select id=\"pskAuthType\" name=\"pskAuthType\" class=\"M\">\r\n<option value=\"0\" class=\"T T_auto\">Auto</option>\r\n<option value=\"1\">WPA-PSK</option>\r\n<option value=\"2\">WPA2-PSK</option>\r\n</select></p>\r\n<p><b class=\"item L T T_encryption\">Encryption:</b> <select id=\"pskCipher\" name=\"pskCipher\" class=\"M\">\r\n<option value=\"0\" id=\"tag_auto\" class=\"T T_auto\">Auto</option>\r\n<option value=\"1\">TKIP</option>\r\n<option value=\"2\">AES</option>\r\n</select></p>\r\n<p><b class=\"item L T T_wlpwd\">Password:</b> <input type=text id=pskSecret  class=text value=\"\" size=\"40\" maxlength=\"64\" /></p>\r\n\r\n<p><b class=\"item L T\" id=\"t_time\">Group Key Update Period:</b> <input id=interval type=text class=text value=\"\" size=\"9\" maxlength=\"9\" /></p>\r\n<p class=\"br\"></p>\r\n<p><input name=\"secType\" type=\"radio\" value=\"2\" id=\"secWPA\" /> <b id=\"t_wpaEnterprise\">WPA/WPA2 - Enterprise</b></p>\r\n<p><b class=\"item L T T_version\">Version:</b> <select id=\"wpaAuthType\" name=\"wpaAuthType\" class=\"M\">\r\n<option value=\"0\" class=\"T T_auto\">Auto</option>\r\n<option value=\"1\">WPA</option>\r\n<option value=\"2\">WPA2</option>\r\n</select></p>\r\n<p><b class=\"item L T T_encryption\">Encryption:</b> <select id=\"wpaCipher\" name=\"wpaCipher\" class=\"M\">\r\n<option value=\"0\" id=\"tag_auto\" class=\"T T_auto\">Auto</option>\r\n<option value=\"1\">TKIP</option>\r\n<option value=\"2\">AES</option>\r\n</select></p>\r\n<p><b class=\"item L T\" id=\"t_srvIp\">RADIUS Server IP:</b> <input type=text id=wpaSerIP  class=text value=\"\" size=\"15\" maxlength=\"15\" /></p>\r\n<p><b class=\"item L T\" id=\"t_srvPort\">RADIUS Server Port:</b> <input type=text id=wpaSerPort  class=text value=\"\" size=\"5\" maxlength=\"5\" /><span class=\"T\" id=\"t_wlRadiusPort\">(1-65535, 0 stands for default port 1812)</span></p>\r\n<p><b class=\"item L T\" id=\"t_srvPwd\">RADIUS Server Password:</b> <input type=text id=wpaSerPwd  class=text value=\"\" size=\"40\" maxlength=\"64\" /></p>\r\n<p><b class=\"item L T\" id=\"t_wlSec_t19\">Group Key Update Period:</b> <input id=wpainterval type=text class=text value=\"\" size=\"9\" maxlength=\"9\" /></p>\r\n<p class=\"br\"></p>\r\n<p><input name=\"secType\" type=\"radio\" value=\"1\" id=\"secWEP\" /> <b>WEP</b></p>\r\n<p><b class=\"item L T T_authtype\">Authentication Type:</b> <select id=\"wepAuthType\" name=\"webAuthType\" class=\"M\">\r\n<option value=\"auto\" class=\"T T_auto\">Auto</option>\r\n<option value=\"open\" class=\"T T_opensys\">Open System</option>\r\n<option value=\"shared\" class=\"T T_sharekey\">Shared Key</option>\r\n</select></p>\r\n<p><b class=\"item L T\" id=\"t_weptype\">WEP Key Format:</b> <select id=\"wepKeyType\" name=\"wepKeyType\" onchange=\"setKey();\" class=\"M\">\r\n<option value=1 class=\"T\" id=\"t_hex\">Hexadecimal</option>\r\n<option value=2>ASCII</option>\r\n</select></p>\r\n<p><b class=\"item L T\" id=\"t_selkey\">Selected Key:</b><b class=\"fl T\" style=\"width:276px\" id=\"t_wepkey\">WEP Key</b><b class=\"T T_keytype\">Key Type</b></p>\r\n<p id=\"wepKeySet1\"></p><p id=\"wepKeySet2\"></p><p id=\"wepKeySet3\"></p><p id=\"wepKeySet4\"></p>\r\n\r\n</div>\r\n<p class=\"bl\"></p>\r\n<p class=\"tail\" id=\"tail\">\r\n<input type=\"button\" class=\"button L T T_save\" value=\"Save\" onclick=\"doSave(this);\" />\r\n</p>\r\n</div>\r\n<script language=\"javascript\" type=\"text/javascript\">$.loadHelpFrame(\"WlanSecurityHelpRpm.htm\");var wepKeyArray=new Array(4);var beaconType,basicAuthenticationMode,WEPKeyIndex,wepLevel,basicEncryptionModes,WPAEncryptionModes,WPAAuthenticationMode,IEEE11iAuthenticationMode,X_TP_PreSharedKey,X_TP_RadiusServerIP,X_TP_RadiusServerPort,X_TP_RadiusServerPassword;var wlanList=$.act(ACT_GL,LAN_WLAN,null,null,[\"name\",\"SSID\",\"Enable\",\"X_TP_Configuration_Modified\",\"beaconType\",\"Standard\",\"WEPEncryptionLevel\",\"WEPKeyIndex\",\"BasicEncryptionModes\",\"BasicAuthenticationMode\",\"WPAEncryptionModes\",\"WPAAuthenticationMode\",\"IEEE11iEncryptionModes\",\"IEEE11iAuthenticationMode\",\"X_TP_PreSharedKey\",\"X_TP_GroupKeyUpdateInterval\"]);var wepList,wpsObj,wlanEn,qssEn,wlanObj;if(INCLUDE_LAN_WLAN_MSSID){var mssidObj;var vapObj}if(!$.exe()){wlanObj=wlanList[0];wepList=$.act(ACT_GL,LAN_WLAN_WEPKEY,null,wlanObj.__stack,[\"WEPKey\"]);wpsObj=$.act(ACT_GET,LAN_WLAN_WPS,wlanObj.__stack,null,[\"Enable\"]);if(INCLUDE_LAN_WLAN_MSSID){mssidObj=$.act(ACT_GET,LAN_WLAN_MULTISSID,wlanObj.__stack,null,[\"MultiSSIDEnable\"])}if(!$.exe()){}wlanEn=wlanObj.enable;qssEn=wpsObj.enable}initShow(0);if(INCLUDE_LAN_WLAN_MSSID){var vapList=$.act(ACT_GS,LAN_WLAN_MSSIDENTRY,null,wlanObj.__stack,[\"Name\",\"Enable\",\"SSID\",\"SSIDAdvertisementEnable\",\"isolateClients\",\"BeaconType\",\"BasicAuthenticationMode\",\"WEPKeyIndex\",\"BasicEncryptionModes\",\"WPAEncryptionModes\",\"WPAAuthenticationMode\",\"IEEE11iEncryptionModes\",\"IEEE11iAuthenticationMode\",\"PreSharedKey\",\"GroupKeyUpdateInterval\",\"radiusServerIP\",\"radiusServerPort\",\"radiusServerPassword\"]);if(INCLUDE_LAN_WLAN_GUESTNETWORK){var guestNetObj=$.act(ACT_GET,LAN_WLAN_GUESTNET,wlanObj.__stack,null,[\"Name\"])}if(!$.exe()){initSelect()}};</script>\r\n"
