ease input another one.\";e_str[CMM_CFG_FILE_TOO_LONG]=\"Invalid file size! Please check your file and try again.\";e_str[CMM_CFG_FILE_FORMAT_ERR]=\"You put a wrong file.\";e_str[CMM_UPDATE_FILE_LEN_ERR]=\"Invalid file size! Please check your file and try again.\";e_str[CMM_UPDATE_FILE_VER_ERR]=\"The uploaded file was not accepted by the device.\";e_str[CMM_GET_SIGN_ERR]=\"Error! Please try again.\";e_str[CMM_RESTORE_DEFAULT_CFG_ERR]=\"Failed to restore default settings.\";e_str[CMM_UPDATE_ADDI_HW_VER_ERR]=\"The uploaded file does not match the device's current hardware version.\";e_str[CMM_FW_ILLEGAL_IP]=\"Invalid IP address!\";e_str[CMM_FW_NOT_LAN_IP]=\"The LAN Host IP is not in the same subnet with LAN IP. Please input another one.\";e_str[CMM_FW_LAN_IP]=\"The WAN Host IP and current LAN IP are in the same subnet. Please input another one.\";e_str[CMM_FW_ILLEGAL_PORT]=\"Invalid port number! Please input another one(1-65535).\";e_str[CMM_FW_ILLEGAL_MAC]=\"Invalid MAC address! The valid format is '00-00-00-00-00-00'.\";e_str[CMM_FW_EMPTY_INTERNAL_HOST]=\"Please at least configure IP address, Port or MAC Address for the LAN Host.\";e_str[CMM_FW_EMPTY_EXTERNAL_HOST]=\"Please at least configure IP Address, Port or MAC Address for the WAN Host.\";e_str[CMM_FW_EMPTY_TASK_SCHEDULE]=\"Please configure time for the new schedule.\";e_str[CMM_FW_EMPTY_RULE]=\"Please at least configure LAN Host or WAN Host for the Filtering Rule.\";e_str[CMM_FW_ILLEGAL_RULE]=\"Invalid filtering rule. Please input another one.\";e_str[CMM_FW_CONFLICT_INTERNAL_HOST]=\"The added LAN Host conflicts with the existing LAN Hosts.\";e_str[CMM_FW_CONFLICT_EXTERNAL_HOST]=\"The added WAN Host conflicts with the existing WAN Hosts.\";e_str[CMM_FW_CONFLICT_TASK_SCHEDULE]=\"The added schedule conflicts with the existing schedule.\";e_str[CMM_FW_CONFLICT_RULE]=\"The added filtering rule conflicts with the existing rules.\";e_str[CMM_FW_EMPTY_URL]=\"Please input at least a URL of a website!\";e_str[CMM_FW_RE