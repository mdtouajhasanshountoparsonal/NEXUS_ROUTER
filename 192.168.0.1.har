            "mimeType": "text/html",
            "compression": 0,
            "text": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\"\r\n    \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n<HTML>\r\n<HEAD>\r\n    <TITLE></TITLE>\r\n\t<META http-equiv=Content-Type content=\"text/html; charset=iso-8859-1\">\r\n\t\r\n\t<script src=\"./js/oid_str.js\" type=\"text/javascript\"></script>\r\n\t<script src=\"./js/lib.js\" type=\"text/javascript\"></script>\r\n</HEAD>\r\n<style type=\"text/css\">\r\ndiv.qr-code-container{\r\n\twidth: 100%;\r\n\tposition: absolute;\r\n\tbottom: 37px;\r\n\tright: 0px;\r\n\tz-index: 0;\r\n\t/*background-color: #f2f2f3;*/\r\n}\r\ndiv.qr-code-container div.qr-code-container-wrapper{\r\n    margin: 0 auto;\r\n\twidth:1000px;\r\n\t/*background-color:#f2f2f3;*/\r\n}\r\ndiv.qr-code-container div.qr-code-container-wrapper div.qr-code{\r\n\tfont-size: 0;\r\n\tposition: relative;\r\n\tbackground-color: #f2f2f3;\r\n}\r\ndiv.qr-code-container div.qr-code-container-wrapper div.characters-illustrate{\r\n\twidth: 340px;\r\n\theight: 66px;\r\n\tpadding: 31px 148px 42px 148px;\r\n\tdisplay: inline-block;\r\n\tvertical-align: top;\r\n}\r\ndiv.qr-code-container div.qr-code-container-wrapper span.characters-illustrate-title{\r\n\tfont-size: 15px;\r\n\tfont-family: Arial;\r\n\tcolor: #36444b;\r\n}\r\ndiv.qr-code-container div.qr-code-container-wrapper span.characters-illustrate-note{\r\n\twidth:100%;\r\n\tfont-size: 12px;\r\n\tfont-family: Arial;\r\n\tcolor: #36444b;\r\n\tmargin-top: 16px;\r\n    display: inline-block;\r\n    line-height: 18px;\r\n}\r\nspan.qr-code-picture{\r\n\tdisplay: inline-block;\r\n\twidth: 100px;\r\n\theight: 100px;\r\n\tmargin: 25px 11px 0 0;\r\n\tbackground: url(./img/login/qr.png) no-repeat -2px -2px;\r\n}\r\ndiv.app-download-place{\r\n\tdisplay: inline-block;\r\n\tpadding-top: 29px;\r\n\tvertical-align: top;\r\n}\r\ndiv.app-download-place a{\r\n\twidth: 136px;\r\n\theight: 40px;\r\n\tdisplay: block;\r\n\tcursor: pointer;\r\n}\r\ndiv.app-download-place a.apple-store{\r\n\tbackground: url(./img/login/qr.png) no-repeat -112px -2px;\r\n}\r\ndiv.app-download-place a.google-play{\r\n\tbackground: url(./img/login/qr.png) no-repeat -112px -63px;\r\n\tmargin-top: 12px;\r\n}\r\ndiv.qr-code-container-wrapper span.close-icon{\r\n\twidth: 20px;\r\n\theight: 20px;\r\n\tdisplay: block;\r\n\tbackground: url(./img/login/qr.png) no-repeat -263px -26px;\r\n\tposition: absolute;\r\n\ttop: 10px;\r\n\tright: 10px;\r\n}\r\ndiv.qr-code-container-wrapper span.close-icon:hover{\r\n\tbackground: url(./img/login/qr.png) no-repeat -263px -56px;\r\n\tcursor: pointer;\r\n}\r\ndiv.qr-code-container div.qr-code-container-delta {\r\n    width: 24px;\r\n    height: 14px;\r\n    margin-left: 955px;\r\n    vertical-align: top;\r\n    background: url(\"./img/login/qr.png\") no-repeat scroll -260px -3px transparent;\r\n}\r\ndiv.footer-container{\r\n\tdisplay: block;\r\n\t/*height:35px;*/\r\n\twidth:100%;\r\n\tbottom: 0px;\r\n\tposition: absolute;\r\n\tz-index: 2;\r\n\tbackground-color: #f2f2f3;\r\n}\r\ndiv.footer-container div.footer-container-wrap{\r\n\tposition: relative;\r\n\tz-index: 1;\r\n\twidth:1000px;\r\n\tmargin:0 auto;\r\n\tpadding: 13px 0px;\r\n\tbackground-color: #f2f2f3;\r\n\theight:13px;\r\n}\r\ndiv.footer-container div.footer-container-wrap span.footer-container-wrap-show{\r\n\tfloat: right;\r\n}\r\ndiv.footer-container a.btn-app{\r\n\tfont-family: Verdana,Geneva,sans-serif;\r\n\tmargin-left: 15px;\r\n\tpadding-right: 13px;\r\n\tcolor:#4D4D4D;\r\n\ttext-decoration: underline;\r\n\tcursor: pointer;\r\n}\r\n#btn-support{\r\n\tdisplay: none;\r\n}\r\n</style>\r\n<BODY leftMargin=0 topMargin=0 marginheight=\"0\" marginwidth=\"0\">\r\n<div id=\"qr-code-container\" class=\"qr-code-container\">\r\n\t<div class=\"qr-code-container-wrapper\">\r\n\t\t<div id=\"qr-code-content\" class=\"qr-code\">\r\n\t\t\t<span id=\"close-icon\" class=\"close-icon\" onclick=\"closeFrame()\"></span>\r\n\t\t\t<div id=\"characters-illustrate\" class=\"characters-illustrate\">\r\n\t\t\t\t<span id=\"characters-illustrate-title\" class=\"characters-illustrate-title T\">Scan the QR code to download TP-Link Tether app</span>\r\n\t\t\t\t<span id=\"characters-illustrate-note\" class=\"characters-illustrate-note T\">Conveniently manage your network from any mobile device.<br />Complete control from the palm of your hand.</span>\r\n\t\t\t</div>\r\n\t\t\t<span class=\"qr-code-picture\"></span>\r\n\t\t\t<div class=\"app-download-place\">\r\n\t\t\t\t<a class=\"apple-store\" target=\"_blank\" href=\"https://itunes.apple.com/us/app/tp-link-tether/id599496594?ls=1&mt=8\"></a>\r\n\t\t\t\t<a class=\"google-play\" target=\"_blank\" href=\"https://play.google.com/store/apps/details?id=com.tplink.tether\"></a>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\t\t<div id=\"qr-code-container-delta\" class=\"qr-code-container-delta\"></div>\r\n\t</div>\r\n</div>\r\n<div id=\"footer-container\" class=\"footer-container\" >\r\n\t<div id=\"footer-wrap\" class=\"footer-container-wrap\">\r\n\t\t<span class=\"footer-container-wrap-show\">\r\n\t\t\t<a id = \"btn-support\" class=\"btn-app\" href=\"http://www.tp-link.com/en/Support/\" target= \"_blank\">Support</a>\r\n\t\t\t<a id = \"btn-app\" class=\"btn-app\" onclick=\"btnAppHandler()\">App</a>\r\n\r\n\t\t</span>\r\n\t</div>\r\n</div>\r\n</BODY>\r\n<script type=\"text/javascript\">var lang=\"en_US\";closeFrame();if(window.parent.$.country){lang=window.parent.$.country;if(window.parent.$.fd==0){showQRcode()}}if(typeof INCLUDE_PORTABLE_APP==\"undefined\"||INCLUDE_PORTABLE_APP!=1){if(window.parent.document.getElementsByTagName(\"frameset\")[2]){window.parent.document.getElementsByTagName(\"frameset\")[2].rows=\"*\"}else{self.frameElement.style.display=\"none\"}}function closeFrame(){document.getElementById(\"qr-code-container\").style.display=\"none\";if(window.parent.document.getElementsByTagName(\"frameset\")[2]){window.parent.document.getElementsByTagName(\"frameset\")[2].rows=\"*,40\"}else{self.frameElement.style.height=\"30px\"}}function showQRcode(){document.getElementById(\"qr-code-container\").style.display=\"block\";if(window.parent.document.getElementsByTagName(\"frameset\")[2]){window.parent.document.getElementsByTagName(\"frameset\")[2].rows=\"*,197\"}else{self.frameElement.style.height=\"200px\"}}function btnAppHandler(){var oldDiplay=document.getElementById(\"qr-code-container\").style.display;if(oldDiplay==\"none\"){showQRcode()}else{closeFrame()}}function resizeHandler(){var width=document.body.clientWidth;var minWidth=700;var maxWidth=1000;if(width<=minWidth){document.getElementById(\"footer-wrap\").style.width=minWidth+\"px\";document.getElementById(\"qr-code-content\").style.width=minWidth+\"px\";document.getElementById(\"qr-code-container-delta\").style.marginLeft=(minWidth-45)+\"px\";document.getElementById(\"characters-illustrate\").style.padding=\"31px 28px 42px 28px\"}if(width>=maxWidth){document.getElementById(\"footer-wrap\").style.width=maxWidth+\"px\";document.getElementById(\"qr-code-content\").style.width=maxWidth+\"px\";document.getElementById(\"qr-code-container-delta\").style.marginLeft=(maxWidth-45)+\"px\";document.getElementById(\"characters-illustrate\").style.padding=\"31px 148px 42px 148px\"}if((width>minWidth)&&(width<maxWidth)){document.getElementById(\"footer-wrap\").style.width=width+\"px\";document.getElementById(\"qr-code-content\").style.width=width+\"px\";document.getElementById(\"qr-code-container-delta\").style.marginLeft=(width-45)+\"px\";document.getElementById(\"characters-illustrate\").style.padding=\"31px \"+(148-0.4*(maxWidth-width))+\"px 42px \"+(148-0.4*(maxWidth-width))+\"px\"}}document.body.onresize=resizeHandler;document.body.onload=resizeHandler;if(window.parent.localString){document.getElementById(\"characters-illustrate-title\").innerHTML=window.parent.localString[lang].QR_TITLE;document.getElementById(\"characters-illustrate-note\").innerHTML=window.parent.localString[lang].QR_NOTE;document.getElementById(\"btn-app\").innerHTML=window.parent.localString[lang].APP;document.getElementById(\"btn-support\").innerHTML=window.parent.localString[lang].SUPPORT}if(typeof INCLUDE_WEBUI_SUPPORT!=\"undefined\"&&INCLUDE_WEBUI_SUPPORT==1){document.getElementById(\"btn-support\").style.display=\"inline\";var SUPPORT={BG_BG:\"http://www.tp-link.bg/Support/\",CS_CZ:\"http://www.tp-link.com/cz/Support/\",DA_DK:\"http://www.tp-link.com/dk/Support/\",DE_DE:\"http://www.tp-link.com.de/Support\",EN_US:\"http://www.tp-link.com/en/Support/\",ES_ES:\"http://www.tp-link.com/es/Support/\",ES_LA:\"http://www.tp-link.com/ar/Support/\",ES_MX:\"http://www.tp-link.com.mx/Support/\",FI_FI:\"http://www.tp-link.com/fi/Support/\",FR_FR:\"http://www.tp-link.com/fr/Support/\",EN_CA:\"http://www.tp-link.com/ca/Support/\",FR_CA:\"http://www.tp-link.com/fr-ca/Support/\",IT_IT:\"http://www.tp-link.com/it/Support/\",JP_JP:\"http://www.tp-link.com/jp/Support/\",KO_KR:\"http://www.tp-link.com/kr/Support/\",NL_NL:\"http://www.tp-link.com/nl/Support/\",NO_NO:\"http://www.tp-link.com/no/Support/\",PL_PL:\"http://www.tp-link.com/pl/Support/\",PT_PT:\"http://www.tp-link.com/pt/Support/\",PT_BR:\"http://www.tp-link.com.br/Support/\",RO_RO:\"http://www.tp-link.com/ro/Support/\",RU_RU:\"http://www.tp-link.com/ru/Support/\",SK_SK:\"http://www.tp-link.sk/Support/\",SV_SE:\"http://www.tp-link.com/se/Support/\",TH_TH:\"http://www.tp-link.com/th/Support/\",TR_TR:\"http://www.tp-link.com/tr/Support/\",UK_UA:\"http://www.tp-link.com/uk/Support/\",VI_VN:\"http://www.tp-link.com/vn/Support/\",ZH_CN:\"http://www.tp-link.com/ch/Support/\",ZH_TW:\"http://www.tp-link.com/tw/Support/\"};setTimeout(function(){if(typeof INCLUDE_MULTILOCALCOEX!=\"undefined\"&&INCLUDE_MULTILOCALCOEX==1){var currentLanguage=lang||parent.window.localStorage.getItem(\"lang\")||\"en_US\"}else{var currentLanguage=parent.window.localStorage.getItem(\"lang\")||lang||\"en_US\"}if(typeof INCLUDE_CANADA_SPEC!=\"undefined\"&&INCLUDE_CANADA_SPEC==1){var currentLanguage=window.parent.localString[lang].LANG||parent.window.localStorage.getItem(\"lang\")||\"en_US\"}document.getElementById(\"btn-support\").href=SUPPORT[currentLanguage.toUpperCase()]},1000)};</script>\r\n</HTML>\r\n"
