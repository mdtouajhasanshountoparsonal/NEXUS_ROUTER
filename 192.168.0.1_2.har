            "text": "<script language=\"javascript\" type=\"text/javascript\">var ASCII=\"0123456789ABCDEFabcdefGHIJKLMNOPQRSTUVWXYZghijklmnopqrstuvwxyz`~!@#$^&*()-=_+[]{};:'\\\"\\\\|/?.,<>/% \";function isHex(str,arg){str=str.toLowerCase();for(var i=0;i<str.length;i++){if((str.charAt(i)>=\"0\"&&str.charAt(i)<=\"9\")||(str.charAt(i)>=\"a\"&&str.charAt(i)<=\"f\")){continue}else{if(arg!=0){$.alert(ERR_WLAN_WEP_KEY_HEX_INVALID)}return false}}if(parseInt(str,16)==0){if(arg!=0){$.alert(ERR_WLAN_WEP_KEY_HEX_INVALID)}return false}return true}function wepOnfocus(i){$.id(\"keynum\"+i).checked=true}function setKey(){for(var i=1;i<=4;i++){if($.id(\"length\"+i).value==0){$.id(\"key\"+i).disabled=true;$.id(\"keynum\"+i).disabled=true;if($.id(\"keynum\"+i).checked==true){var temp=(i+1)%4;if(0==temp){temp=4}$.id(\"keynum\"+temp).checked=true}}else{$.id(\"key\"+i).disabled=false;$.id(\"keynum\"+i).disabled=false;if($.id(\"wepKeyType\").value==1){$.id(\"key\"+i).value=$.id(\"key\"+i).value.substr(0,Math.floor($.id(\"length\"+i).value/4));$.id(\"key\"+i).maxLength=$.id(\"length\"+i).value/4}else{if($.id(\"wepKeyType\").value==2){$.id(\"key\"+i).value=$.id(\"key\"+i).value.substr(0,Math.floor($.id(\"length\"+i).value/8));$.id(\"key\"+i).maxLength=$.id(\"length\"+i).value/8}}}}}function disableWEP(){$.id(\"secWEP\").disabled=true;$.id(\"wepAuthType\").disabled=true;$.id(\"wepKeyType\").disabled=true;var wepIndex=1;for(wepIndex=1;wepIndex<=4;wepIndex++){$.id(\"keynum\"+wepIndex).disabled=true;$.id(\"key\"+wepIndex).disabled=true;$.id(\"length\"+wepIndex).disabled=true}}function disableWPA(){$.id(\"secWPA\").disabled=true;$.id(\"wpaAuthType\").disabled=true;$.id(\"wpaCipher\").disabled=true;$.id(\"wpaSerIP\").disabled=true;$.id(\"wpaSerPort\").disabled=true;$.id(\"wpaSerPwd\").disabled=true;$.id(\"wpainterval\").disabled=true}function getParam(){if($.id(\"apsec\").value==0){beaconType=wlanObj.beaconType;basicAuthenticationMode=wlanObj.basicAuthenticationMode;WEPKeyIndex=wlanObj.WEPKeyInd