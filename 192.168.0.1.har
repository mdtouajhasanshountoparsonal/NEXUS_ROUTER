rate:\"Min Bandwidth\",t_maxrate:\"Max Bandwidth\",t_up:\"Egress Bandwidth:\",t_down:\"Ingress Bandwidth:\",t_accTime:\"Access Time:\",t_bandSel:\"Band Select\",t_stanum:\"Max Guests number\",t_disWlSec:\"Disable Wireless Security\",t_time:\"Group Key Update Period\",t_timeval:\"minimum is 30, 0 means no update\",t_timeout:\"Timeout\",t_schedule:\"Schedule\",t_wlSecduleTip:\"Click the schedule table or use the 'Add' button to choose the period on which you need the guest network off automatically!\",t_wlSched:\"Wireless Schedule\",t_setto:\"Apply To\",t_start:\"Start Time\",t_end:\"End Time\",t_day:\"Each Day\",t_week:\"Each Week\",t_clear:\"Clear Schedule\",t_uptime1:\"Remaining Time\",t_fbwifi:\"Facebook Wi-Fi:\",t_none:\"None\",t_checkinName:\"Facebook Check-in Location:\",t_connectNetwork:\"Connect to Network\",t_networkNote:\"Failed to connect to the Facebook server. Please close this window and check your network connection.\",portal_err_network:\"Failed to connect to the Facebook server.\",portal_err_config:\"Please set up Facebook Wi-Fi and close the window when the settings are saved.\",portal_note:\"Please enable at least one guest network band and set it to No Security before using Facebook Wi-Fi.\",facebookConfigBtn:\"Set Up on Facebook\"},wlGuestStatus:{et:\"Guest Network Status\",t_info:\"This page displays the basic information of all guests connected on this wireless network.\",t_tip:\"Currently Connected Guest Network Clients:\",t_curstat1:\"Current Status\",t_curstat2:\"Current Status\",t_rxpkts1:\"Received Packets\",t_rxpkts2:\"Received Packets\",t_txpkts1:\"Sent Packets\",t_txpkts2:\"Sent Packets\"},wlBasicRE:{et:\"Wireless Settings\",t_connect:\"Connect to Host Network\",t_brssid:\"SSID(to be bridged):\",t_brbssid:\"MAC Address(to be bridged):\",t_wep_notice:\"We do not recommend using the WEP encryption if this device operates in 802.11n mode due to the fact that WEP is not supported by 802.11n specification.\",t_tkip_notice:\"We do not recomme