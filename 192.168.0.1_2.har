ength\"+i+\" class=list id=length\"+i+\" onchange=setKey()></select>\";htmlStr+=keyIndexStr+inputStr+\" \"+keyTypeStr;$.h($.id(\"wepKeySet\"+i),htmlStr)}if(\"None\"==basicAuthenticationMode){$.id(\"wepAuthType\").selectedIndex=1}else{if(\"SharedAuthentication\"==basicAuthenticationMode){$.id(\"wepAuthType\").selectedIndex=2}else{if(\"Auto\"==basicAuthenticationMode){$.id(\"wepAuthType\").selectedIndex=0}}}$.id(\"keynum\"+WEPKeyIndex).checked=true;for(i=1;i<=4;i++){$.id(\"key\"+i).value=wepKeyArray[i-1]}for(i=1;i<=4;i++){while($.id(\"length\"+i).options.length>0){$.id(\"length\"+i).remove(0)}}$.each(wepLevel,function(){for(i=1;i<=4;i++){var opt=$.c(\"option\");opt.value=this;if(\"Disabled\"==this){opt.text=m_str.disabled;opt.value=0}else{var temp=this.split(\"-\");opt.text=(parseInt(temp[0])+24)+\"bit\";opt.value=parseInt(temp[0])}try{$.id(\"length\"+i).add(opt,null)}catch(e){$.id(\"length\"+i).add(opt)}}});$.id(\"wepKeyType\").selectedIndex=0;for(i=1;i<=4;i++){if($.id(\"keynum\"+i).checked==true){for(var j=0;j<wepLevel.length;j++){if(wepLevel[j]!=\"Disabled\"){var temp=wepLevel[j].split(\"-\");if($.id(\"key\"+i).value.length==parseInt(temp[0])/8){$.id(\"wepKeyType\").selectedIndex=1;break}}}}}for(i=1;i<=4;i++){var keyLen;if($.id(\"wepKeyType\").value==1){keyLen=$.id(\"key\"+i).value.length*4}else{keyLen=$.id(\"key\"+i).value.length*8}for(var j=0;j<$.id(\"length\"+i).options.length;j++){if($.id(\"length\"+i).options[j].value==keyLen){$.id(\"length\"+i).selectedIndex=j}}}setKey()}function secTypeInit(){if(beaconType==\"Basic\"&&basicEncryptionModes==\"None\"){$.id(\"secNone\").checked=true}else{if(beaconType==\"Basic\"&&basicEncryptionModes==\"WEPEncryption\"){$.id(\"secWEP\").checked=true}else{if(beaconType==\"WPA\"){if(WPAAuthenticationMode==\"PSKAuthentication\"){$.id(\"secPSK\").checked=true}else{$.id(\"secWPA\").checked=true}}else{if(beaconType==\"11i\"||beaconType==\"WPAand11i\"){if(IEEE11iAuthenticationMode==\"PSKAuthentication\"){$.id(\"secPSK\").checked=true}else{$.id(\"secWPA\").checked=true}}else{}}}}}function initWPAShow(){if(beaconType==\"WPAand11i\"&&WPAAuthenticationMode==\"EAPAuthentication\"){$.id(\"wpaAuthType\").selectedIndex=0;if(IEEE11iEncryptionModes==\"TKIPEncryption\"){$.id(\"wpaCipher\").selectedIndex=1}else{if(IEEE11iEncryptionModes==\"AESEncryption\"){$.id(\"wpaCipher\").selectedIndex=2}else{$.id(\"wpaCipher\").selectedIndex=0}}$.id(\"wpaSerPwd\").value=X_TP_RadiusServerPassword;$.id(\"wpainterval\").value=X_TP_GroupKeyUpdateInterval;$.id(\"wpaSerIP\").value=X_TP_RadiusServerIP;$.id(\"wpaSerPort\").value=X_TP_RadiusServerPort;$.id(\"wpaSerPwd\").value=X_TP_RadiusServerPassword}else{if(beaconType==\"WPA\"&&WPAAuthenticationMode==\"EAPAuthentication\"){$.id(\"wpaAuthType\").selectedIndex=1;if(WPAEncryptionModes==\"TKIPEncryption\"){$.id(\"wpaCipher\").selectedIndex=1}else{if(WPAEncryptionModes==\"AESEncryption\"){$.id(\"wpaCipher\").selectedIndex=2}else{$.id(\"wpaCipher\").selectedIndex=0}}}else{if(beaconType==\"11i\"&&IEEE11iAuthenticationMode==\"EAPAuthentication\"){$.id(\"wpaAuthType\").selectedIndex=2;if(IEEE11iEncryptionModes==\"TKIPEncryption\"){$.id(\"wpaCipher\").selectedIndex=1}else{if(IEEE11iEncryptionModes==\"AESEncryption\"){$.id(\"wpaCipher\").selectedIndex=2}else{$.id(\"wpaCipher\").selectedIndex=0}}}else{$.id(\"wpaAuthType\").selectedIndex=0;$.id(\"wpaCipher\").selectedIndex=0}}}$.id(\"wpaSerPwd\").value=X_TP_RadiusServerPassword;$.id(\"wpainterval\").value=X_TP_GroupKeyUpdateInterval;$.id(\"wpaSerIP\").value=X_TP_RadiusServerIP;$.id(\"wpaSerPort\").value=X_TP_RadiusServerPort}function initPSKShow(){if(beaconType==\"WPAand11i\"&&WPAAuthenticationMode==\"PSKAuthentication\"){$.id(\"pskAuthType\").selectedIndex=0;if(IEEE11iEncryptionModes==\"TKIPEncryption\"){$.id(\"pskCipher\").selectedIndex=1}else{if(IEEE11iEncryptionModes==\"AESEncryption\"){$.id(\"pskCipher\").selectedIndex=2}else{$.id(\"pskCipher\").selectedIndex=0}}}else{if(beaconType==\"WPA\"&&WPAAuthenticationMode==\"PSKAuthentication\"){$.id(\"pskAuthType\").selectedIndex=1;if(WPAEncryptionModes==\"TKIPEncryption\"){$.id(\"pskCipher\").selectedIndex=1}else{if(WPAEncryptionModes==\"AESEncryption\"){$.id(\"pskCipher\").selectedIndex=2}else{$.id(\"pskCipher\").selectedIndex=0}}}else{if(beaconType==\"11i\"&&IEEE11iAuthenticationMode==\"PSKAuthentication\"){$.id(\"pskAuthType\").selectedIndex=2;if(IEEE11iEncryptionModes==\"TKIPEncryption\"){$.id(\"pskCipher\").selectedIndex=1}else{if(IEEE11iEncryptionModes==\"AESEncryption\"){$.id(\"pskCipher\").selectedIndex=2}else{$.id(\"pskCipher\").selectedIndex=0}}}else{$.id(\"pskAuthType\").selectedIndex=2;$.id(\"pskCipher\").selectedIndex=2}}}$.id(\"pskSecret\").value=X_TP_PreSharedKey;$.id(\"interval\").value=X_TP_GroupKeyUpdateInterval}function initShow(load){if((INCLUDE_LAN_WLAN_MSSID&&!INCLUDE_LAN_WLAN_GUESTNETWORK&&vapList.length==1)||(INCLUDE_LAN_WLAN_MSSID&&1<vapList.length)){}if(load&&INCLUDE_LAN_WLAN_MSSID){$.addLoading($.id(\"apsec\"))}getWlanObj();getParam();secTypeInit();initWEPShow();initPSKShow();initWPAShow();if(INCLUDE_LAN_WLAN_MSSID&&mssidObj.multiSSIDEnable==1){var vapIndex;for(vapIndex=0;vapIndex<vapList.length;vapIndex++){if(vapList[vapIndex].enable==1){disableWEP();$.removeClass($.id(\"mssidTip\"),\"nd\");break}}}if(qssEn==1){disableWEP();disableWPA();$.removeClass($.id(\"qssTip\"),\"nd\")}if(wlanObj.standard==\"n-only\"){$.id(\"secWEP\").disabled=true;$.id(\"pskCipher\").selectedIndex=2;$.id(\"pskCipher\").disabled=true;$.id(\"wpaCipher\").selectedIndex=2;$.id(\"wpaCipher\").disabled=true;$.removeClass($.id(\"11nTip\"),\"nd\")}if(load&&INCLUDE_LAN_WLAN_MSSID){$.removeLoading($.id(\"apsec\"))}}function checkWEP(){if(1==qssEn){$.alert(ERR_WLAN_QSS_WEP_CONFLICT);return false}var i;for(i=1;i<=4;i++){if($.id(\"keynum\"+i).checked==true&&$.id(\"length\"+i).value==0){$.alert(ERR_WLAN_WEP_NO_KEY);return false}if($.id(\"length\"+i).value!=0){if($.id(\"wepKeyType\").value==1){if(!isHex($.id(\"key\"+i).value,1)){$.id(\"key\"+i).focus();$.id(\"key\"+i).select();return false}}else{if($.asc($.id(\"key\"+i).value,true)){$.alert(ERR_WLAN_WEP_KEY_ASCII_INVALID);$.id(\"key\"+i).focus();$.id(\"key\"+i).select();return false}}if($.id(\"key\"+i).value.length<($.id(\"length\"+i).value/($.id(\"wepKeyType\").value==1?4:8))){$.alert(ERR_WLAN_WEP_KEY_LENGTH_INVALID);$.id(\"key\"+i).focus();$.id(\"key\"+i).select();return false}}}return true}function checkWPA(){if($.ifip($.id(\"wpaSerIP\").value)){$.id(\"wpaSerIP\").focus();$.id(\"wpaSerIP\").select();return false}if($.id(\"wpaSerPort\").value==0){$.id(\"wpaSerPort\").value=1812}if($.id(\"wpaSerPort\").value>65535||$.id(\"wpaSerPort\").value<1){$.alert(ERR_WLAN_WPA_PORT_INVALID);$.id(\"wpaSerPort\").focus();$.id(\"wpaSerPort\").select();return false}var pwd=$.id(\"wpaSerPwd\").value;if(pwd.length==0){$.alert(ERR_WLAN_WPA_PWD_EMPTY);$.id(\"wpaSerPwd\").focus();$.id(\"wpaSerPwd\").select();return false}else{if(pwd.length>64){$.alert(ERR_WLAN_WPA_PWD_INVALID);$.id(\"wpaSerPwd\").focus();$.id(\"wpaSerPwd\").select();return false}}if($.num($.id(\"wpainterval\").value,0,[30,999999999],true)){$.alert(ERR_WLAN_WPA_INTERVAL_INVALID);$.id(\"wpainterval\").focus();$.id(\"wpainterval\").select();return false}if(1==qssEn){$.alert(ERR_WLAN_QSS_WPA_CONFLICT);return false}return true}function checkPSK(){var psk=$.id(\"pskSecret\").value;if(psk.length==0){$.alert(ERR_WLAN_WPA_PSK_EMPTY);$.id(\"pskSecret\").focus();$.id(\"pskSecret\").select();return false}else{if(psk.length<8){$.alert(ERR_WLAN_WPA_PSK_LENGTH_INVALID);$.id(\"pskSecret\").focus();$.id(\"pskSecret\").select();return false}else{if(psk.length>=64){if(!isHex(psk,0)){$.alert(ERR_WLAN_WPA_PSK_HEX_INVALID);$.id(\"pskSecret\").focus();$.id(\"pskSecret\").select();return false}$.id(\"pskSecret\").value=$.id(\"pskSecret\").value.substr(0,64)}else{if($.asc(psk,true)){$.alert(ERR_WLAN_WPA_PSK_ASCII_INVALID);$.id(\"pskSecret\").focus();$.id(\"pskSecret\").select();return false}}}}if($.num($.id(\"interval\").value,0,[30,999999999],true)){$.alert(ERR_WLAN_WPA_INTERVAL_INVALID);return false}if(1==qssEn){if(1==$.id(\"pskCipher\").value){$.alert(ERR_WLAN_QSS_TKIP_CONFLICT);return false}}return true}function checkValue(){if($.id(\"secNone\").checked==true){return true}else{if($.id(\"secWEP\").checked==true){return checkWEP()}else{if($.id(\"secPSK\").checked==true){return checkPSK()}else{if($.id(\"secWPA\").checked==true){return checkWPA()}else{return false}}}}}function doWlanSubmit(){if($.id(\"secNone\").checked==true){$.act(ACT_SET,LAN_WLAN,wlanObj.__stack,null,[\"BeaconType=Basic\",\"BasicEncryptionModes=None\",\"BasicAuthenticationMode=None\"])}else{if($.id(\"secWEP\").checked==true){var index=1;var authType;if($.id(\"wepAuthType\").value==\"auto\"){authType=\"Auto\"}else{if($.id(\"wepAuthType\").value==\"shared\"){authType=\"SharedAuthentication\"}else{authType=\"None\"}}$.each(wepList,function(arg,index){var key;if($.id(\"length\"+(index+1)).value==0){key=\"\"}else{key=$.id(\"key\"+(index+1)).value}$.act(ACT_SET,LAN_WLAN_WEPKEY,this.__stack,null,[\"WEPKey=\"+key])});for(var index=1;index<=4;index++){if($.id(\"keynum\"+index).checked==true){break}}$.act(ACT_SET,LAN_WLAN,wlanObj.__stack,null,[\"BeaconType=Basic\",\"WEPKeyIndex=\"+index,\"BasicAuthenticationMode=\"+authType,\"BasicEncryptionModes=WEPEncryption\"])}else{if($.id(\"secPSK\").checked==true){var groupInterval=parseInt($.id(\"interval\").value,10);var encryType;if($.id(\"pskCipher\").value==0){encryType=\"TKIPandAESEncryption\"}else{if($.id(\"pskCipher\").value==1){encryType=\"TKIPEncryption\"}else{encryType=\"AESEncryption\"}}if($.id(\"pskAuthType\").value==0){$.act(ACT_SET,LAN_WLAN,wlanObj.__stack,null,[\"BeaconType=WPAand11i\",\"WPAEncryptionModes=\"+encryType,\"WPAAuthenticationMode=PSKAuthentication\",\"IEEE11iAuthenticationMode=PSKAuthentication\",\"IEEE11iEncryptionModes=\"+encryType,\"X_TP_PreSharedKey=\"+$.id(\"pskSecret\").value,\"X_TP_GroupKeyUpdateInterval=\"+groupInterval])}else{if($.id(\"pskAuthType\").value==1){$.act(ACT_SET,LA