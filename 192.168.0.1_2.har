ACH_MAX_URL]=\"URL number has reached the upper limit!\";e_str[CMM_FW_REQ_DENY]=\"The entry is in use, delete is not allowed!\";e_str[CMM_FW_MALLOC_RULE_FAILED]=\"Internal error occurred in rule setting.\";e_str[CMM_FW_SET_DEFAULT_ACTION_FAILED]=\"Failed to configure the default filtering rule.\";e_str[CMM_FW_SET_URL_FAILED]=\"Failed to configure URL!\";e_str[CMM_PC_MAC_IS_SAME_WITH_PARENT_MAC]=\"MAC Address of Child's PC should differ from that of Parental PC. Please input another one. \";e_str[CMM_FW_NAME_INCLUDE_INVALID_CHAR]='The input value should not contain: \\\\/\":*?<>|&. Please input another one.';e_str[CMM_FW_NAME_END_WITH_SPACE]=\"The input value should not end with whitespace characters. Please input another one.\";e_str[CMM_FW_INVILID_URL]=\"The input URL contains illegal characters. Please input another one.\";e_str[CMM_PC_MAC_IS_SAME_WITH_CHILD_MAC]=\"MAC Address of Parental PC should differ from that of Child's PC. Please input another one.\";e_str[CMM_TC_DOWN_BANDWIDTH]=\"System can't satisfy the requested min downstream rate. Please input again.\";e_str[CMM_TC_UP_BANDWIDTH]=\"System can't satisfy the requested min upstream rate. Please input again.\";e_str[CMM_TC_CONFLICT]=\"The added rule conflicts with the existing rules.\";e_str[CMM_TC_START_IP_ERROR]=\"The Start IP Address is the same as LAN IP or not in the same subnet with LAN IP address. Please input another one.\";e_str[CMM_TC_END_IP_ERROR]=\"The End IP Address is the same as LAN IP or not in the same subnet with LAN IP address. Please input another one.\";e_str[CMM_TC_DOWN_TOTAL_BW]=\"The Total Ingress Bandwidth should not be less than the summation of all the min downstream rate of enabled rules.\";e_str[CMM_TC_UP_TOTAL_BW]=\"The Total Egress Bandwidth should not be less than the summation of all the min upstream rate of enabled rules.\";e_str[CMM_TC_MAX_ERROR]=\"Bandwidth control rules list is full! Please delete one existing rule before adding a new one.\";e_str[CMM_TC_DOWN_ENABLE_BANDWIDTH]=\"System can't satisfy the min downstream rate. Please modify the min downstream rate and try again.\";e_str[CMM_TC_UP_ENABLE_BANDWIDTH]=\"System can't satisfy the min upstream rate. Please modify the min upstream rate and try again.\";e_str[CMM_QOS_EMPTY_QUEUE]=\"The business or flow classification must be bound to one queue!\";e_str[CMM_QOS_WRR_TOTALBW_ZERO]=\"The weight of the added WRR queue must be greater than 0!\";e_str[CMM_QOS_MAX_PRIO]=\"The precedence of the added SP queue must not be greater than 8!\";e_str[CMM_QOS_SAME_QUEUE_NAME]=\"The queue name of the queues with the same QoS direction must be different!\";e_str[CMM_QOS_SAME_QUEUE_PRIO]=\"The precedence of the added SP queue must not be same with the existing SP queue!\";e_str[CMM_QOS_MAX_QUEUE_WEIGHT]=\"The summation of all WRR queues with the same QoS direction must not be greater than 100!\";e_str[CMM_QOS_SCH_NOT_SUPPORTED]=\"System can't support the requested scheduler algorithm!\";e_str[CMM_QOS_SAME_APP_NAME]=\"The business name of the added business classification must not be same with the existing business classification!\";e_str[CMM_QOS_NONEXIST_APP_INTF]=\"The QoS interface to which the business classification is bound does not exist!\";e_str[CMM_QOS_NOT_WAN_APP_INTF]=\"Business classification must be only used for upstream QoS!\";e_str[CMM_QOS_NONEXIST_APP_QUEUE]=\"The QoS queue to which the business classification is bound does not exist!\";e_str[CMM_QOS_NONEXIST_CLS_INTF]=\"The QoS interface to which the flow classification is bound does not exist!\";e_str[CMM_QOS_NONEXIST_CLS_QUEUE]=\"The QoS queue to which the flow classification is bound does not exist!\";e_str[CMM_QOS_EMPTY_CLS_INGRESS_INTF]=\"Invalid ingress interface of the flow classification!\";e_str[CMM_QOS_SAME_CLS_NAME]=\"The class name of the added flow classification must not be same with the existing flow classification!\";e_str[CMM_QOS_SAME_CLS_CRITERION]=\"The criteria of the added classification must not be same wit