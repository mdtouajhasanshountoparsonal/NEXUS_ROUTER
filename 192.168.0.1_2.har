            "size": 1312,
            "mimeType": "text/html",
            "compression": 0,
            "text": "<html>\r\n<head><title>Archer C7</title></head>\r\n<link href=\"../css/css_help.css\" rel=\"stylesheet\" type=\"text/css\">\r\n<script type=\"text/javascript\">function Click(){return false}document.oncontextmenu=Click;</script>\r\n<body>\r\n<h1 class=\"header\">Wireless Statistics Help</h1>\r\n<p class=\"brief\">This page shows <b>MAC Address</b>, <b>Current Status</b>, <b>Received Packets</b>, <b>Sent Packets</b> and <b>SSID</b> for each connected wireless station. </p>\r\n\r\n<ul>\r\n<li class=\"mac_addr\"><b>MAC Address</b> - the connected wireless station's MAC address</li>\r\n<li class=\"curr_status\"><b>Current Status</b> - the connected wireless station's running status. </li>\r\n<li class=\"rece_packets\"><b>Received Packets</b> - packets received by the station</li>\r\n\r\n<li class=\"sent_pack\"><b>Sent Packets</b> - spackets sent by the station</li>\r\n<li class=\"ssid\"><b>SSID</b> - SSID that the station associates with</li>\r\n</ul>\r\n<p class=\"refresh\">You cannot change any of the values on this page. To update this page and to show the current connected wireless stations, click on the <b>Refresh</b> button. </p>\r\n\r\n<p class=\"note\"><b>Note:</b> This page will be refreshed automatically every 5 seconds.</p>\r\n</body>\r\n</html>\r\n<script language=\"javascript\" type=\"text/javascript\">window.parent.$.transHelp(document.URL);</script>\r\n"
