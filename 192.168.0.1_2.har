            "text": "html{overflow:auto;}body{margin-left:0;FONT-FAMILY:Arial,Helvetica,Geneva,Swiss,SunSans-Regular;WHITE-SPACE:nowrap;BACKGROUND-COLOR:#4ACBD6;}#menu{margin-top:0;margin-left:0;PADDING-LEFT:0;FONT-SIZE:14px;TEXT-DECORATION:none;color:#36444b;width:100%;overflow:hidden;}#menu ul.mu1{margin:0;padding:0;}#menu li.ml1{margin:0 0 2px 0;PADDING-LEFT:0;TEXT-DECORATION:none;line-height:24px;list-style:inside none;}#menu ul.mu2{margin:0;padding:0;PADDING-LEFT:0;TEXT-DECORATION:none;line-height:24px;list-style:inside none;}#menu ul.mu3{margin:0;padding:0;PADDING-LEFT:0;TEXT-DECORATION:none;line-height:24px;list-style:inside none;}#menu a{position:relative;color:#36444B;PADDING-LEFT:24px;noneFocusLine:expression(this.onFocus=this.blur());display:block;background-image:url(../img/menu-white-noradius.png);}#menu a:hover{color:#FFCB00;}#menu li.ml1{filter:alpha(opacity=85);}#menu li.ml1 a.sel{color:#36444B;}#menu li.ml1 a.sel,#menu li.ml1 a.sel.minus{position:relative;background-color:#E3F7F9;background-image:url(../img/menu-yellow.png);}#menu li.ml1 a.sel.minus:hover{color:#36444B;}#menu li.ml1 a.plus.sel:hover{margin:2px 0;}#menu li.ml2 a.sel{background-image:url(../img/menu-white-noradius.png);color:#36444B;border-radius:0;}#menu li.ml2 a{color:#8c9ea2;opacity:.85;filter:alpha(opacity=85);}#menu li.ml2.last-tag a{background-color:#4ACBD6;color:#8c9ea2;opacity:.85;filter:alpha(opacity=85);background-image:url(../img/menu-white.png);}#menu li.ml2.last-tag a.sel{color:#36444B;}#menu li.ml2 a.sel.minus{position:relative;background-color:transparent;background-image:none;}#menu li.ml3 a{padding-left:40px;width:140px;}#menu li.ml3 a.sel{color:#0cf;}#menu ul.mu a{color:#8c9ea2;opacity:.85;filter:alpha(opacity=85);}div{text-align:left;margin:0 auto;}.nd{display:none!important;}a:focus{-moz-outline-style:none;outline:none;}A:visited{TEXT-DECORATION:none;underline:none;}A:hover,ul.mu2 a:hover{CURSOR:hand;color:#FFCB00;TEXT-DECORATION:none;}A:link{TEXT-DECORATION:none;u