            "mimeType": "text/html",
            "compression": 0,
            "text": "<script language=\"javascript\" type=\"text/javascript\">var realMode;function multiModeInit(){if($.mainParam){if($.qd.sysMode===undefined){var multiMode=$.act(ACT_GET,MULTIMODE,null,null);if(!$.exe()){if(multiMode.mode==\"Router\"){$.id(\"Router\").checked=true;$.qd.realMode=\"Router\"}else{if(sysMode.mode==\"AP\"){$.id(\"AP\").checked=true;$.qd.realMode=\"AP\"}else{if(sysMode.mode==\"Repeater\"){$.id(\"Repeater\").checked=true;$.qd.realMode=\"Repeater\"}else{if(sysMode.mode==\"Client\"){$.id(\"Client\").checked=true;$.qd.realMode=\"Client\"}else{if(sysMode.mode==\"MSSID\"){$.id(\"MSSID\").checked=true;$.qd.realMode=\"MSSID\"}else{if(sysMode.mode==\"Hotspot\"){$.id(\"Hotspot\").checked=true;$.qd.realMode=\"Hotspot\"}else{}}}}}}}}else{if($.qd.sysMode==\"Router\"){$.id(\"Router\").checked=true}else{if($.qd.sysMode==\"AP\"){$.id(\"AP\").checked=true}else{if($.qd.sysMode==\"Repeater\"){$.id(\"Repeater\").checked=true}else{if($.qd.sysMode==\"Client\"){$.id(\"Client\").checked=true}else{if($.qd.sysMode==\"MSSID\"){$.id(\"MSSID\").checked=true}else{if($.qd.sysMode==\"Hotspot\"){$.id(\"Hotspot\").checked=true}else{}}}}}}}$.removeClass($.id(\"title_qs\"),\"nd\")}else{var multiMode=$.act(ACT_GET,MULTIMODE,null,null);if(!$.exe()){if(multiMode.mode==\"Router\"){realMode=\"Router\";$.id(\"Router\").checked=true}else{if(multiMode.mode==\"AP\"){realMode=\"AP\";$.id(\"AP\").checked=true}else{if(multiMode.mode==\"Repeater\"){realMode=\"Repeater\";$.id(\"Repeater\").checked=true}else{if(multiMode.mode==\"Client\"){realMode=\"Client\";$.id(\"Client\").checked=true}else{if(multiMode.mode==\"MSSID\"){realMode=\"MSSID\";$.id(\"MSSID\").checked=true}else{if(multiMode.mode==\"Hotspot\"){realMode=\"Hotspot\";$.id(\"Hotspot\").checked=true}}}}}}}$.removeClass($.id(\"title_sysMode\"),\"nd\");$.removeClass($.id(\"b_save\"),\"nd\");$.removeClass($.id(\"tail\"),\"ctr\")}}function doSave(){var multiModeArg={};if($.id(\"Router\").checked){multiModeArg.mode=\"Router\"}else{if($.id(\"AP\").checked){multiModeArg.mode=\"AP\"}else{if($.id(\"Repeater\").checked){multiModeArg.mode=\"Repeater\"}else{if($.id(\"Client\").checked){multiModeArg.mode=\"Client\"}else{if($.id(\"MSSID\").checked){multiModeArg.mode=\"MSSID\"}else{if($.id(\"Hotspot\").checked){multiModeArg.mode=\"Hotspot\"}else{multiModeArg.mode=\"Router\"}}}}}}if(multiModeArg.mode==realMode){$.alert(ERR_MULTI_MODE_ALREADY);return}var r=confirm(c_str.chgmod);if(r==true){$.addLoading($.id(\"b_save\"));$.act(ACT_SET,MULTIMODE,null,null,multiModeArg);$.exe(function(ret){if(!ret){doReboot()}})}else{$.reload()}}function doReboot(){$.guage([\"<span class='T_rebooting'>\"+s_str.rebooting+\"</span>\",\"<span class='T T_wait_reboot'>\"+s_str.wait_reboot+\"</span>\"],100,$.guageInterval,function(){$.refreshWindow()})}function doCollect(){if($.id(\"Router\").checked){$.qd.sysMode=\"Router\"}else{if($.id(\"AP\").checked){$.qd.sysMode=\"AP\"}else{if($.id(\"Repeater\").checked){$.qd.sysMode=\"Repeater\"}else{if($.id(\"Client\").checked){$.qd.sysMode=\"Client\"}else{if($.id(\"MSSID\").checked){$.qd.sysMode=\"MSSID\"}else{if($.id(\"Hotspot\").checked){$.qd.sysMode=\"Hotspot\"}else{$.qd.sysMode=\"Router\"}}}}}}};</script>\r\n<p class=\"et\"><span class=\"nd\" id=\"title_sysMode\"><span class=\"T\" id=\"et1\">Operation Mode</span></span><span class=\"nd\" id=\"title_qs\"><span class=\"T\" id=\"et2\">Quick Setup - Operation Mode</span></span></p>\r\n<div class=\"con1 M\">\r\n<p class=\"ct\"></p>\r\n<p class=\"bl\"></p>\r\n<div class=\"con2\">\r\n<p class=\"T\" id=\"t_mode\">Choose Operation Mode:</p>\r\n<p id=\"m_router\" class=\"nd\">\r\n<input type=\"radio\" name=\"sysMode\" id=\"Router\" value=\"Router\" checked />\r\n<b class=\"T\" id=\"sysmod2\">Wireless Router</b>\r\n</p>\r\n<p id=\"m_hotspot\" class=\"nd\">\r\n<input type=\"radio\" name=\"sysMode\" id=\"Hotspot\" value=\"Hotspot\" />\r\n<b class=\"T\" id=\"sysmod7\">Hotspot Router</b>\r\n</p>\r\n<p id=\"m_ap\" class=\"nd\">\r\n<input type=\"radio\" name=\"sysMode\" id=\"AP\" value=\"AP\" />\r\n<b class=\"T\" id=\"sysmod4\">Access Point</b>\r\n</p>\r\n<p id=\"m_re\" class=\"nd\">\r\n<input type=\"radio\" name=\"sysMode\" id=\"Repeater\" value=\"Repeater\" />\r\n<b class=\"T\" id=\"sysmod6\">Range Extender</b>\r\n</p>\r\n<p id=\"m_client\" class=\"nd\">\r\n<input type=\"radio\" name=\"sysMode\" id=\"Client\" value=\"Client\" />\r\n<b class=\"T\" id=\"sysmod5\">Client</b>\r\n</p>\r\n<p id=\"m_mssid\" class=\"nd\">\r\n<input type=\"radio\" name=\"sysMode\" id=\"MSSID\" value=\"MSSID\" />\r\n<b class=\"T\" id=\"sysmod8\">Multi-SSID</b>\r\n</p>\r\n</div>\r\n<p class=\"bl\"></p>\r\n<p class=\"tail ctr\" id=\"tail\">\r\n<input type=\"button\" class=\"button L nd T T_save\" value=\"Save\" id=\"b_save\" onclick=\"doSave()\" />\r\n</p>\r\n</div>\r\n<script language=\"javascript\" type=\"text/javascript\">if(INCLUDE_MULTIMODE_ROUTER){$.removeClass($.id(\"m_router\"),\"nd\")}if(INCLUDE_MULTIMODE_AP){$.removeClass($.id(\"m_ap\"),\"nd\")}if(INCLUDE_MULTIMODE_RE){$.removeClass($.id(\"m_re\"),\"nd\")}if(INCLUDE_MULTIMODE_CLIENT){$.removeClass($.id(\"m_client\"),\"nd\")}if(INCLUDE_MULTIMODE_MSSID){$.removeClass($.id(\"m_mssid\"),\"nd\")}if(INCLUDE_MULTIMODE_HOTSPOT){$.removeClass($.id(\"m_hotspot\"),\"nd\")}multiModeInit();$.loadHelpFrame(\"QsModeHelpRpm.htm\");</script>\r\n"
