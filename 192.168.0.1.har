            "text": "var localLanguageName={bg_BG:\"Български\",cs_CZ:\"Čeština\",da_DK:\"Dansk\",de_DE:\"Deutsch\",en_US:\"English\",es_ES:\"Español\",es_MX:\"Español(México)\",fi_FI:\"Suomi\",fr_CA:\"Français\",fr_FR:\"Français\",it_IT:\"Italiano\",jp_JP:\"日本語\",ko_KR:\"한국어\",nl_NL:\"Nederlands\",no_NO:\"Norsk\",pl_PL:\"Polski\",pt_BR:\"Português(Brasil)\",pt_PT:\"Português\",ro_RO:\"Română\",ru_RU:\"Русский\",sk_SK:\"Slovenština\",sv_SE:\"Svenska\",th_TH:\"ภาษาไทย\",tr_TR:\"Türkçe\",uk_UA:\"Українська\",vi_VN:\"Tiếng Việt\",zh_CN:\"简体中文\",zh_TW:\"繁體中文\"};var localString={de_DE:{START:\"Start\",LOGIN:\"Einloggen\",USERNAME:\"Benutzername\",PASSWORD:\"Passwort\",NOTE:\"Hinweis:\",MODEL_NO:\"Model No. \",TIP_CONFLICT:\"Es kann immer nur ein Teilnehmer in den Router eingeloggt sein. Bitte versuchen Sie es später noch einmal.\",TIP_ERROR:\"Ungültige Zugangsdaten. Bitte versuchen Sie es noch einmal.\",TIP_EXC1:\"10 Fehlversuche registriert. Bitte versuchen Sie es in \",TIP_EXCE2:\" Sekunden noch einmal.\",QR_TITLE:\"Scannen Sie den QR-Code, um TP-LinksApp „Tether” herunterzuladen.\",QR_NOTE:\"Einfache Verwaltung Ihres Netzes von Ihrem Mobilgerät aus.<br>Sie haben die volle Kontrolle in der Hand.\",APP:\"App\",SUPPORT:\"Support\",USER_NOTE:\"Werter Kunde:\",REDIRECT_NOTE:'Die eingegebene Adresse wird von keinem TP-Link-Produkt benutzt. Um auf Ihre Weboberfläche zuzugreifen, besuchen Sie bitte <a href=\"http://tplinkwifi.net\">tplinkwifi.net</a>.',TO_TPLOGIN:\"Nein, weiter zu tplinklogin.net\",TO_TPWIFI:\"Weiter zu tplinkwifi.net\"},en_US:{START:\"Start\",LOGIN:\"Log In\",USERNAME:\"Username\",PASSWORD:\"Password\",NOTE:\"NOTE:\",MODEL_NO:\"Model No. \",TIP_CONFLICT:\"The device allows only one administrator to login at the same time, please try again later.\",TIP_ERROR:\"The username or password is incorrect, please try again.\",TIP_EXCE1:\"You have exceeded ten attempts. Please try again in \",TIP_EXCE2:\"s.\",QR_TITLE:\"Scan the QR code to download TP-Link Tether app\",QR_NOTE:\"Conveniently manage your network from any mobile device.<br>Complete control from the palm of your hand.\",APP:\"App\",SUPPORT:\"Support\",USER_NOTE:\"Dear Customer:\",REDIRECT_NOTE:'The address you have entered is no longer being used by TP-Link products. To connect to your web management page, please visit <a href=\"http://tplinkwifi.net\">tplinkwifi.net</a>.',TO_TPLOGIN:\"No, take me to tplinklogin.net\",TO_TPWIFI:\"Continue to tplinkwifi.net\"},es_MX:{START:\"Iniciar\",LOGIN:\"Iniciar sesión\",USERNAME:\"Nombre de Usuario\",PASSWORD:\"Contraseña\",NOTE:\"NOTA:\",MODEL_NO:\"Modelo \",TIP_CONFLICT:\"TEl router permite que sólo un administrador pueda iniciar sesión al mismo tiempo, por favor intente de nuevo más tarde.\",TIP_ERROR:\"El nombre de usuario o contraseña es incorrecta, por favor ingrese de nuevo.\",TIP_EXCE1:\"Ha excedido diez intentos, por favor intente de nuevo después de dos horas. \",TIP_EXCE2:\"s.\",QR_TITLE:\"Escana el código QR para descargar TP-Link Tether app\",QR_NOTE:\"Gestiona tu red desde cualquier dispositivo móvil.<br>Control total en la palma de tu mano.\",APP:\"App\",SUPPORT:\"Soporte\",USER_NOTE:\"Estimado Cliente:\",REDIRECT_NOTE:'La dirección que ha ingresado ya no está siendo usada por los productos de TP-Link. Para conectarse a su página de administración a través de Internet, por favor visite <a href=\"http://tplinkwifi.net\">tplinkwifi.net</a>.',TO_TPLOGIN:\"No, lléveme a tplinklogin.net\",TO_TPWIFI:\"Continuar con tplinkwifi.net\"},fr_FR:{START:\"Début\",LOGIN:\"Se connecter\",USERNAME:\"Nom d'utilisateur\",PASSWORD:\"Mot de passe\",NOTE:\"Remarque:\",MODEL_NO:\"Model No. \",TIP_CONFLICT:\"Le routeur permet à un seul administrateur de se connecter en même temps, s'il vous plaît essayer à nouveau plus tard.\",TIP_ERROR:\"Le nom d'utilisateur ou mot de passe est incorrect, s'il vous plaît essayer à nouveau.\",TIP_EXCE1:\"Vous avez dépassé dix tentatives. S'il vous plaît essayer de nouveau dans \",TIP_EXCE2:\"s.\",QR_TITLE:\"Scanner le QR code pour télécharger l'app Tether TP-LINK.\",QR_NOTE:\"Administrez aisément votre réseau depuis n'importe quel appareil iOS ou Android.<br>Contrôle total au creux de la main.\",APP:\"App\",SUPPORT:\"Support\",USER_NOTE:\"Cher client:\",REDIRECT_NOTE:'L’adresse que vous avez saisie n’est plus utilisée par TP-Link. Pour vous connecter à l’adresse d’administration WEB, merci de consulter <a href=\"http://tplinkwifi.net\">tplinkwifi.net</a>.',TO_TPLOGIN:\"Non, conduisez moi vers tplinklogin.net\",TO_TPWIFI:\"Continuer vers tplinkwifi.net\"},fr_CA:{START:\"Début\",LOGIN:\"Se connecter\",USERNAME:\"Nom d'utilisateur\",PASSWORD:\"Mot de passe\",NOTE:\"Remarque:\",MODEL_NO:\"Model No. \",TIP_CONFLICT:\"Le routeur permet à un seul administrateur de se connecter en même temps, s'il vous plaît essayer à nouveau plus tard.\",TIP_ERROR:\"Le nom d'utilisateur ou mot de passe est incorrect, s'il vous plaît essayer à nouveau.\",TIP_EXCE1:\"Vous avez dépassé dix tentatives. S'il vous plaît essayer de nouveau dans \",TIP_EXCE2:\"s.\",QR_TITLE:\"Scanner le QR code pour télécharger l'app Tether TP-LINK.\",QR_NOTE:\"Administrez aisément votre réseau depuis n'importe quel appareil iOS ou Android.<br>Contrôle total au creux de la main.\",APP:\"App\",SUPPORT:\"Tuki\",USER_NOTE:\"Cher client:\",REDIRECT_NOTE:'L’adresse que vous avez saisie n’est plus utilisée par TP-Link. Pour vous connecter à l’adresse d’administration WEB, merci de consulter <a href=\"http://tplinkwifi.net\">tplinkwifi.net</a>.',TO_TPLOGIN:\"Non, conduisez moi vers tplinklogin.net\",TO_TPWIFI:\"Continuer vers tplinkwifi.net\"},jp_JP:{START:\"開始\",LOGIN:\"ログイン\",USERNAME:\"ユーザー名\",PASSWORD:\"パスワード\",NOTE:\"注:\",MODEL_NO:\"モデル番号 \",TIP_CONFLICT:\"ルーターは同時に１人のみの管理者がログインすることを許可します。後で再試行してください。\",TIP_ERROR:\"ユーザー名またはパスワードが正しくありません。もう一度試してください。\",TIP_EXCE1:\"十回以上試みました。\",TIP_EXCE2:\"秒後にも再試行ください。\",QR_TITLE:\"QRコードをスキャンしてTP-Link「Tether」アプリをダウンロード。\",QR_NOTE:\"モバイルデバイスからかんたんにネットワークの管理が可能です。<br>手のひらから完璧なコントロールを行えます。\",APP:\"アプリケーション\",SUPPORT:\"サポート\",USER_NOTE:\"お客様へ：\",REDIRECT_NOTE:'入力されたアドレスは現在TP-Link社製品では使用されておりません。管理画面を開くためにはこちらへアクセスをしてください <a href=\"http://tplinkwifi.net\">tplinkwifi.net</a>。',TO_TPLOGIN:\"いいえ、tplinklogin.netへアクセスします。\",TO_TPWIFI:\"tplinkwifi.netにアクセスする\"},ko_KR:{START:\"시작\",LOGIN:\"로그인\",USERNAME:\"사용자 이름\",PASSWORD:\"비밀번호\",NOTE:\"주의:\",MODEL_NO:\"모델 번호. \",TIP_CONFLICT:\"공유기에 한 명의 관리자가 동시에 로그인할 수 있습니다. 나중에 다시 시도하십시오.\",TIP_ERROR:\"사용자 이름 또는 암호가 정확하지 않으니, 다시 입력해주십시오.\",TIP_EXCE1:\"사용자는 열 번의 시도를 초과하였습니다. 두 시간 후에 다시 시도하십시오. \",TIP_EXCE2:\"s.\",QR_TITLE:\"QR코드를 스캔하여 TP-Link Tether 앱을 다운로드 하세요\",QR_NOTE:\"어떤 모바일 장치에서 편리하게 당신의 네트워크를 관리할 수 있습니다.<br>당신의 손에서 완전한 제어를 하세요.\",APP:\"응용 프로그램\",SUPPORT:\"지원\",USER_NOTE:\"고객님 귀하:\",REDIRECT_NOTE:'입력하신 주소는 더 이상 사용하지 않습니다. 웹 관리 페이지에 접근하려면 <a href=\"http://tplinkwifi.net\">tplinkwifi.net</a> 으로 접속하세요.',TO_TPLOGIN:\"아니요, tplinklogin.net으로 이동하겠습니까\",TO_TPWIFI:\"tplinkwifi.net을 계속 연결합니다\"},pl_PL:{START:\"Początek\",LOGIN:\"Zaloguj\",USERNAME:\"Nazwa użytkownika\",PASSWORD:\"Hasło\",NOTE:\"UWAGA:\",MODEL_NO:\"Model No. \",TIP_CONFLICT:\"Tylko jeden administrator może być zalogowany na routerze, spróbuj ponownie później.\",TIP_ERROR:\"Nazwa użytkownika lub hasło są nieprawidłowe, wprowadź je ponownie.\",TIP_EXCE1:\"Limit dziesięciu prób został przekroczony. Spróbuj ponownie za \",TIP_EXCE2:\"s.\",QR_TITLE:\"Zeskanuj kod QR, aby pobrać aplikację TP-Link Tether.\",QR_NOTE:\"Zarządzaj swoją siecią z każdego urządzenia mobilnego.<br>Pełna kontrola w zasięgu ręki.\",APP:\"Usługa\",SUPPORT:\"Wsparcie\",USER_NOTE:\"Drogi użytkowniku:\",REDIRECT_NOTE:'Adres, który wprowadziłeś nie jest już używany przez produkty TP-Link. Aby połączyć się ze stroną konfiguracyjną urządzenia, wprowadź <a href=\"http://tplinkwifi.net\">tplinkwifi.net</a>.',TO_TPLOGIN:\"Nie, przekieruj mnie do tplinklogin.net\",TO_TPWIFI:\"Kontynuuj do tplinkwifi.net\"},pt_BR:{START:\"Início\",LOGIN:\"Login\",USERNAME:\"Nome de usuário\",PASSWORD:\"Senha\",NOTE:\"NOTA:\",MODEL_NO:\"Número do Modelo \",TIP_CONFLICT:\"O roteador permite apenas um administrador fazendo o login por vez, por favor, tente mais tarde.\",TIP_ERROR:\"O nome de usuário e senha está incorreto, por favor, tente novamente.\",TIP_EXCE1:\"Você excedeu 10 tentativas. Tente de novo em \",TIP_EXCE2:\"s.\",QR_TITLE:\"Leia o código QR para descarregar o App TP-Link Tether.\",QR_NOTE:\"Gerir de forma fácil e conveniente a sua rede a partir de qualquer dispositivo.\",APP:\"App\",SUPPORT:\"Suporte\",USER_NOTE:\"Querido Usuário:\",REDIRECT_NOTE:'O endereço que você inseriu não é mais utilizado pelos produtos TP-Link. Para conectar à página de configuração, visite <a href=\"http://tplinkwifi.net\">tplinkwifi.net</a>.',TO_TPLOGIN:\"Não, leve-me para tplinklogin.net\",TO_TPWIFI:\"Continuar em tplinkwifi.net\"},ro_RO:{START:\"Început\",LOGIN:\"Autentificare\",USERNAME:\"Nume de utilizator\",PASSWORD:\"Parolă\",NOTE:\"NOTĂ:\",MODEL_NO:\"Model No. \",TIP_CONFLICT:\"Routerul permite un singur administrator să fie autentificat simultan, vă rugăm să încercați mai târziu.\",TIP_ERROR:\"Numele de utilizator sau parola sunt incorect, vă rugăm să le introduceți din nou.\",TIP_EXCE1:\"Ați depășit zece încercări, vă rugăm să încercați din nou peste două ore. \",TIP_EXCE2:\"s.\",QR_TITLE:\"Scanează codul QR pentru a descărca aplicația TP-Link Tether.\",QR_NOTE:\"Administrează rețeaua ta de pe orice dispozitiv mobil.<br>Control deplin direct din palma ta.\",APP:\"Aplicația\",SUPPORT:\"Asistență\",USER_NOTE:\"Dragă client:\",REDIRECT_NOTE:'Adresa introdusă nu mai este utilizată de produsele TP-Link. Pentru conectarea la pagina de administrare web, te rugăm să accesezi <a href=\"http://tplinkwifi.net\">tplinkwifi.net</a>.',TO_TPLOGIN:\"Nu, du-mă la tplinklogin.net\",TO_TPWIFI:\"Accesează tplinkwifi.net\"},ru_RU:{START:\"Начало\",LOGIN:\"Войдите\",USERNAME:\"Имя пользователя\",PASSWORD:\"Пароль\",NOTE:\"ПРИМЕЧАНИЕ:\",MODEL_NO:\"Модель \",TIP_CONFLICT:\"К маршрутизатору возможно только одно подключение с правами администратора, пожалуйста, повторите попытку позже.\",TIP_ERROR:\"Имя пользователя или пароль указаны неверно, введите ещё раз.\",TIP_EXCE1:\"Вы превысили десять попыток. Пожалуйста, попробуйте ещё раз \",TIP_EXCE2:\"секунд.\",QR_TITLE:\"Отсканируйте QR-коддлязагрузкиприложенияTP-Link Tether.\",QR_NOTE:\"Управляйтесетьюсудобствомслюбогомобильногоустройства.<br>Абсолютный контрольу вас на ладони.\",APP:\"Приложение\",SUPPORT:\"Поддержка\",USER_NOTE:\"Уважаемый пользователь:\",REDIRECT_NOTE:'Указанный вами адрес больше не используется продукцией TP-Link. Для подключения к веб-интерфейсу управления посетите страницу: <a href=\"http://tplinkwifi.net\">tplinkwifi.net</a>.',TO_TPLOGIN:\"Нет, перейти на tplinklogin.net\",TO_TPWIFI:\"Продолжить переход на tplinkwifi.net\"},vi_VN:{START:\"Bắt đầu\",LOGIN:\"Đăng nhập\",USERNAME:\"Tên đăng nhập\",PASSWORD:\"Mật mã\",NOTE:\"LUU Ý:\",MODEL_NO:\"Số model:\",TIP_CONFLICT:\"Router chỉ cho phép duy nhất một quản trị viên đăng nhập tại cùng một thời điểm, vui lòng thử lại sau.\",TIP_ERROR:\"Tên đăng nhâp và mật mã không chính xác, vui lòng nhập lại.\",TIP_EXCE1:\"Bạn đã thử 10 lần. Vui lòng thử lại sau \",TIP_EXCE2:\"s.\",QR_TITLE:\"Quét mã QR để tải ứng dụng Tether TP-Link\",QR_NOTE:\"Để thuận tiện quản lý mạng của bạn từ bất kỳ thiết bị di động nào.<br>Kiểm soát mọi thứ trong lòng bàn tay.\",APP:\"Ứng dụng\",SUPPORT:\"Hỗ trợ\",USER_NOTE:\"Thưa Quý khách hàng:\",REDIRECT_NOTE:'Địa chỉ mà bạn đã nhập không còn được sử dụng bởi các sản phẩm TP-Link. Để kết nối với trang web quản lý của bạn, vui lòng truy cập <a href=\"http://tplinkwifi.net\">tplinkwifi.net</a>.',TO_TPLOGIN:\"Không, đưa tôi đến tplinklogin.net\",TO_TPWIFI:\"Tiếp tục đến tplinkwifi.net\"},zh_TW:{START:\"開始\",LOGIN:\"登入\",USERNAME:\"使用者名稱\",PASSWORD:\"密碼\",NOTE:\"請注意：\",MODEL_NO:\"產品型號  \",TIP_CONFLICT:\"路由器在同時間內僅允許一個管理員登入，請稍後再重試一次。\",TIP_ERROR:\"使用者名稱與密碼不正確，請重試一次。\",TIP_EXCE1:\"您已經嘗試登入超過10次，請\",TIP_EXCE2:\"秒後再試一次。\",QR_TITLE:\"掃描此QR碼以下載TP-Link Tether app\",QR_NOTE:\"方便您可以從任何行動設備管理您的網路。<br>完全由您一手掌控。\",APP:\"App\",SUPPORT:\"支援\",USER_NOTE:\"親愛的客戶：\",REDIRECT_NOTE:'您輸入的位址已經不再被TP-Link產品使用。若要連線至您的網頁管理頁面，請拜訪 <a href=\"http://tplinkwifi.net\">tplinkwifi.net</a>。',TO_TPLOGIN:\"不，我要前往網站tplinklogin.net\",TO_TPWIFI:\"好，我要前往管理頁面tplinkwifi.net\"}};"
